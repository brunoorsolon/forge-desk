{
  "name": "forge-desk",
  "version": "3.0.2",
  "description": "Deterministic dependency graph and execution order for open issues",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "forge-desk": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "dev": "tsx watch src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "commander": "^15.0.0",
    "fastify": "^5.12.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^22.20.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
